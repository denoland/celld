{
  "name": "cellverse",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:fe dev:be",
    "dev:fe": "vite",
    "dev:be": "docker run -v $PWD/data:/data -e RUST_LOG=info -e CELL_DENO_OUTPUT=1 -e CELL_GRACE_PERIOD_SECONDS=1 -p 8000:8000 -v $PWD:/app cells:latest cells/main.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "preact": "^10.26.5"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.1",
    "npm-run-all": "^4.1.5",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
